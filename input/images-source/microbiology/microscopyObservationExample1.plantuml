@startuml
skinparam linetype polyline
' hide circle
' hide stereotype
hide empty members

object "Microscopy Observation" as mo1  {
    <color:blue>Code = LOINC ("specific observation target", Specimen, PrID)
    <color:blue>   system = Specimen</color>
    <color:blue>   component = {specific target}</color>
    <color:blue>   scale = PrID</color>
    ..
    Method = SNOMED CT (< 278289002 | Microscopy technique (qualifier value))
    ..
    Result = SNOMED CT
    <color:black>   </color>
    <color:black>   </color>
    ..
    Interpretation = SNOMED CT ()
    ..
    Data Absent Reason =
}

