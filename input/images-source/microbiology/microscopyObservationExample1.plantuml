    <color:blue>   system = Specimen</color>
    <color:blue>   component = {specific target}</color>
    <color:blue>   scale = PrID</color>
    ..
    <color:green>Code = NPU ("specific observation target", Syst(spec.), ???)
    <color:green>   system = Syst(spec.)</color>
    <color:green>   component = {specific target}</color>
    <color:green>   property = ???</color>
    ..
    Method = SNOMED CT (< 278289002 | Microscopy technique (qualifier value))
